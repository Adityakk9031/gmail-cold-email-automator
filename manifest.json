{
  "manifest_version": 3,
  "name": "Cold Email Automator (Gmail & Zoho Mail)",
  "version": "1.3.0",
  "description": "Automate personalized cold emails with resume attachments directly inside Gmail and Zoho Mail at safe intervals.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://*.zoho.com/*",
    "https://*.zoho.in/*",
    "https://*.zoho.eu/*",
    "https://*.zoho.com.au/*",
    "https://*.zoho.jp/*",
    "https://*.zoho.ca/*",
    "https://*.zoho.sa/*",
    "https://*.zoho.com.cn/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cold Email Automator (Gmail & Zoho Mail)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://*.zoho.com/*",
        "https://*.zoho.in/*",
        "https://*.zoho.eu/*",
        "https://*.zoho.com.au/*",
        "https://*.zoho.jp/*",
        "https://*.zoho.ca/*",
        "https://*.zoho.sa/*",
        "https://*.zoho.com.cn/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
